# ==============================================================================
# ZYNC SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Local: Copy this file to .env and fill in MONGODB_URI and JWT_SECRET
# Render: Add these keys under Environment Variables in the Render dashboard.
# NOTE: Do NOT set PORT manually on Render (Render injects process.env.PORT automatically).
# ==============================================================================

# Server HTTP Port (Local only; Render dynamically assigns this)
PORT=5000

# MongoDB Atlas Connection URI
# Production: Create a dedicated database user with readWrite on "zync" database
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zync?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zync?retryWrites=true&w=majority

# JWT Authentication Secret
# MUST be a cryptographically secure random string (min 32 chars).
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars

# JWT Cookie Expiration window (must match cookie maxAge)
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL (Used for CORS and Cookie origin validation)
# Local: http://localhost:5173
# Production (Render): https://zync-monitor.vercel.app
# IMPORTANT: Must NOT end with a trailing slash!
CLIENT_URL=http://localhost:5173

# Node Environment ("development" or "production")
# Production enables Secure/SameSite=None cookies and hides stack traces
NODE_ENV=development

# SSRF Protection: Allow private/loopback/cloud metadata IP pings
# MUST be false in production
ALLOW_PRIVATE_URLS=false

# Background Heartbeat Worker
ENABLE_SCHEDULER=true
SCHEDULER_TICK_MS=5000
PING_TIMEOUT_MS=10000
MAX_CONCURRENT_PINGS=10
