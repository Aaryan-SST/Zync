# ==============================================================================
# ZYNC CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Production (Vercel): Set under Project Settings -> Environment Variables
# Local Development: Defaults to /api (proxied via Vite dev server)
#
# NOTE: VITE_* variables are baked into the static bundle at build time.
# Any change to these variables requires a full project redeploy / rebuild.
# ==============================================================================

# Production Backend API URL (with trailing /api)
# Production: https://zync-backend.onrender.com/api
# Local: http://localhost:5000/api
VITE_API_BASE_URL=https://zync-backend.onrender.com/api

# Optional override for Socket.io server (defaults to VITE_API_BASE_URL without /api)
# VITE_SOCKET_URL=https://zync-backend.onrender.com
